# À saisir dans Dokploy > Environment. Ne commitez jamais les vraies valeurs.
POSTGRES_DB=mixo
POSTGRES_USER=mixo
POSTGRES_PASSWORD=changez-par-un-mot-de-passe-long-et-unique

SECRET_KEY=generez-une-cle-django-longue-et-unique
ALLOWED_HOSTS=app.votre-domaine.com
FRONTEND_URL=https://app.votre-domaine.com
CORS_ALLOWED_ORIGINS=https://app.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://app.votre-domaine.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_ADMIN_CREDENTIALS_JSON={"type":"service_account"}

# Variables intégrées au build Vite (elles sont publiques côté navigateur).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
